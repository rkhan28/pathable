# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PathAble backend. Leave empty until the API exists.
NEXT_PUBLIC_PATHABLE_API_URL=

# Use clearly labelled development fixtures when no API is configured.
# Defaults: true in `next dev`, false in production builds. Set to true for a public demo.
NEXT_PUBLIC_DEV_FIXTURES=

# MapLibre style URLs (defaults: OpenFreeMap, no key needed).
# e.g. https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
NEXT_PUBLIC_MAP_STYLE_LIGHT=
NEXT_PUBLIC_MAP_STYLE_DARK=

# Photon-compatible geocoder (default: https://photon.komoot.io — fine for development;
# self-host or use a commercial Photon provider for production traffic).
NEXT_PUBLIC_GEOCODER_URL=

# Public support channel shown on the contact page (e.g. a GitHub issues URL).
NEXT_PUBLIC_SUPPORT_URL=
NEXT_PUBLIC_REPO_URL=
