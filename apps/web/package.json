{
  "name": "@pathable/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/sync-contracts.mjs && node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/sync-contracts.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-contracts.mjs && node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "contrast": "node scripts/check-contrast.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check": "npm run contrast && npm run check:copy && npm run lint && npm run typecheck && npm run test",
    "test:e2e": "playwright test",
    "contracts": "node --experimental-strip-types scripts/build-openapi.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@hookform/resolvers": "^7.0.1",
    "@tanstack/react-query": "^5.105.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.67.0",
    "maplibre-gl": "^6.16.0",
    "motion": "^14.9.0",
    "next": "16.4.4",
    "next-intl": "^4.14.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "intl-messageformat": "^12.1.4",
    "jsdom": "^29.1.1",
    "lighthouse": "^12.8.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
